# Copy to .env.production and keep that file out of Git.
APP_DOMAIN=app.example.com
SERVER_PUBLIC_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com
TRUST_PROXY_HOPS=2

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zumbarl?schema=public&sslmode=require
REDIS_URL=rediss://USER:PASSWORD@HOST:6379
JWT_SECRET=replace-with-at-least-32-random-characters
DEPLOYMENT_PURPOSE=live
AUTH_COOKIE_NAME=zumbarl_session
AUTH_SESSION_TTL_SECONDS=604800

LEGAL_POLICIES_APPROVED=false
ODPC_REGISTRATION_NUMBER=
BACKGROUND_JOBS_MODE=external

MPESA_PROVIDER=daraja
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORT_CODE=replace-me
MPESA_PASSKEY=replace-me
MPESA_CALLBACK_BASE_URL=https://app.example.com
MPESA_REQUEST_TIMEOUT_MS=15000
MPESA_B2C_SHORT_CODE=replace-me
MPESA_INITIATOR_NAME=replace-me
MPESA_SECURITY_CREDENTIAL=replace-me

STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_BUCKET=zumbarl-production
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me

EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-me
MAIL_PASS=replace-me

SMS_PROVIDER=disabled
SMS_API_KEY=disabled
SMS_USERNAME=disabled
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCOUNT_SID=
WHATSAPP_ACCESS_TOKEN=disabled
WHATSAPP_SENDER_ID=disabled

JITSI_PUBLIC_URL=https://meet.example.com
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=4000
DELIVERY_HAVERSINE_FALLBACK_FACTOR=1.3
GEOCODING_BASE_URL=https://photon.komoot.io
ANTHROPIC_MODEL=claude-opus-4-8

RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
EVERGREEN_QUALIFICATION_GIGS=3
EVERGREEN_REPEAT_HIRE_LIMIT=3
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_CONNECTION_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=15000

# Pass this file explicitly: docker compose --env-file .env.bootstrap ...
APP_DOMAIN=129.151.192.171.sslip.io

POSTGRES_DB=zumbarl
POSTGRES_USER=zumbarl
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
REDIS_PASSWORD=replace-with-a-url-safe-random-password

SERVER_PUBLIC_URL=https://129.151.192.171.sslip.io
JITSI_PUBLIC_URL=https://meet.jit.si
DATABASE_URL=postgresql://zumbarl:replace-with-a-url-safe-random-password@postgres:5432/zumbarl?schema=public
REDIS_URL=redis://:replace-with-a-url-safe-random-password@redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
DEPLOYMENT_PURPOSE=demo
AUTH_COOKIE_NAME=zumbarl_session
AUTH_SESSION_TTL_SECONDS=604800
LEGAL_POLICIES_APPROVED=false
CORS_ORIGIN=https://129.151.192.171.sslip.io
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
EVERGREEN_QUALIFICATION_GIGS=3
EVERGREEN_REPEAT_HIRE_LIMIT=3

# External delivery is intentionally disabled on this private demo host.
MPESA_PROVIDER=disabled
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=disabled-demo
MPESA_CONSUMER_SECRET=disabled-demo
MPESA_SHORT_CODE=174379
MPESA_PASSKEY=disabled-demo
MPESA_CALLBACK_BASE_URL=https://129.151.192.171.sslip.io
MPESA_REQUEST_TIMEOUT_MS=15000
STORAGE_PROVIDER=s3
SMS_PROVIDER=disabled
SMS_API_KEY=disabled
SMS_USERNAME=disabled
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=disabled
WHATSAPP_SENDER_ID=disabled
EMAIL_PROVIDER=disabled
EMAIL_FROM=demo@zumbarl.invalid
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false

# Private, versioned OCI Object Storage bucket and its dedicated credential.
OBJECT_STORAGE_ENDPOINT=https://YOUR_NAMESPACE.compat.objectstorage.eu-stockholm-1.oraclecloud.com
OBJECT_STORAGE_BUCKET=zumbarl-production-demo
OBJECT_STORAGE_REGION=eu-stockholm-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-dedicated-customer-secret-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-dedicated-customer-secret

HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_CONNECTION_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
TRUST_PROXY_HOPS=2
READINESS_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=15000
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=4000
DELIVERY_HAVERSINE_FALLBACK_FACTOR=1.3
GEOCODING_BASE_URL=https://photon.komoot.io
ANTHROPIC_MODEL=claude-opus-4-8

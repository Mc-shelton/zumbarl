# Local-only OCI retry configuration. Copy to .env.retry; never commit it.
OCI_PROFILE=DEFAULT
OCI_CLI=/usr/local/bin/oci
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..replace-me
OCI_AVAILABILITY_DOMAIN=replace-me
OCI_IMAGE_ID=ocid1.image.oc1..replace-me
OCI_SUBNET_ID=ocid1.subnet.oc1..replace-me
OCI_SSH_PUBLIC_KEY=/absolute/path/to/zumbarl_oci.pub
OCI_STATE_DIR=/absolute/path/to/.config/zumbarl-oci
OCI_INSTANCE_NAME=zumbarl-demo
OCI_OCPUS=2
OCI_MEMORY_GB=12
OCI_BOOT_VOLUME_GB=100

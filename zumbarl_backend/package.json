{
  "name": "zumbarl-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Zumbarl API backend for student, business, earn, learn, connect, marketplace, finance, and wellness workflows.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "NODE_ENV=test vitest run",
    "test:isolated": "sh scripts/runTestsWithServices.sh",
    "lint": "eslint \"src/**/*.ts\"",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "jitsi:up": "docker compose --project-directory ../infrastructure/jitsi up -d",
    "jitsi:down": "docker compose --project-directory ../infrastructure/jitsi down",
    "jitsi:logs": "docker compose --project-directory ../infrastructure/jitsi logs -f",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "data:migrate": "tsx src/data/runDataMigrations.ts",
    "release:prepare": "npm run db:migrate:deploy && npm run data:migrate",
    "release:repository-check": "sh scripts/verifyReleaseRepository.sh",
    "go-live:verify": "npm run release:repository-check && npm run lint && npm run build && npm audit --omit=dev --audit-level=high && npm run mpesa:verify",
    "db:seed": "tsx src/data/seedDatabase.ts",
    "demo:seed": "npm run db:seed && tsx src/data/seedCoreDemoJourney.ts",
    "demo:verify": "tsx src/data/verifyCoreDemoJourney.ts",
    "mpesa:verify": "tsx src/data/verifyMpesaConfiguration.ts",
    "titles:normalize": "tsx src/data/normalizeStoredTitles.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "recommendations:setup": "sh recommendations/setup.sh",
    "recommendations:train": "sh recommendations/run.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "nanoid": "^5.1.16",
    "nodemailer": "^10.0.10",
    "sharp": "^0.34.5",
    "tesseract.js": "^6.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}

# =============================================================================
# Application and HTTP server
# =============================================================================
NODE_ENV=development
PORT=4100
HOST=0.0.0.0
SERVER_PUBLIC_URL=http://localhost:4100

# =============================================================================
# Realtime meetings
# =============================================================================
JITSI_PUBLIC_URL=http://localhost:18000

# =============================================================================
# Persistence and cache
# =============================================================================
DATABASE_URL=postgresql://zumbarl:zumbarl@localhost:55432/zumbarl?schema=public
REDIS_URL=redis://localhost:56379

# =============================================================================
# Authentication, CORS, and rate limiting
# =============================================================================
JWT_SECRET=replace-with-a-long-random-secret
# `demo` permits production runtime hardening without representing the service
# as legally approved for processing live user data.
DEPLOYMENT_PURPOSE=demo
# The cookie is an HTTP-only fallback for protected GETs such as private images.
# API mutations continue to require the bearer token.
AUTH_COOKIE_NAME=zumbarl_session
AUTH_SESSION_TTL_SECONDS=604800
# Production refuses to start until the displayed policies have been approved
# and the responsible entity's ODPC registration has been recorded.
LEGAL_POLICIES_APPROVED=false
# ODPC_REGISTRATION_NUMBER=
# Use inline only for local development. Production requires a worker process.
BACKGROUND_JOBS_MODE=inline
CORS_ORIGIN=http://localhost:5173,https://127.0.0.1:5174
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute

# =============================================================================
# Evergreen placement rules
# =============================================================================
EVERGREEN_QUALIFICATION_GIGS=3
EVERGREEN_REPEAT_HIRE_LIMIT=3

# =============================================================================
# M-Pesa payments
# =============================================================================
MPESA_PROVIDER=daraja
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORT_CODE=174379
MPESA_PASSKEY=replace-me
# Public HTTPS origin that Safaricom can reach. Callback paths and one-time
# request tokens are appended by the backend.
# MPESA_CALLBACK_BASE_URL=https://api.example.com
MPESA_REQUEST_TIMEOUT_MS=15000
# Required only when enabling direct student M-Pesa withdrawals (B2C).
# MPESA_B2C_SHORT_CODE=
# MPESA_INITIATOR_NAME=
# MPESA_SECURITY_CREDENTIAL=

# Local is for development only. Production startup requires s3.
STORAGE_PROVIDER=local

# =============================================================================
# SMS notifications
# =============================================================================
SMS_PROVIDER=africas_talking
SMS_API_KEY=replace-me
SMS_USERNAME=sandbox

# =============================================================================
# WhatsApp notifications
# =============================================================================
WHATSAPP_PROVIDER=twilio
# Twilio Account SID (AC followed by 32 hexadecimal characters).
WHATSAPP_ACCOUNT_SID=AC00000000000000000000000000000000
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_SENDER_ID=whatsapp:+14155238886

# =============================================================================
# Email notifications
# =============================================================================
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@zumbarl.local
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# Use true for implicit TLS, normally on port 465. Port 587 normally uses
# STARTTLS and should remain false here.
MAIL_SECURE=false
MAIL_USER=replace-me
MAIL_PASS=replace-me

# =============================================================================
# Object storage
# =============================================================================
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=zumbarl-local
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=zumbarl
OBJECT_STORAGE_SECRET_ACCESS_KEY=zumbarl-local-secret

# =============================================================================
# HTTP availability
# =============================================================================
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_CONNECTION_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
TRUST_PROXY_HOPS=0
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=15000

# =============================================================================
# Delivery routing and geocoding
# =============================================================================
OSRM_BASE_URL=http://127.0.0.1:55000
OSRM_TIMEOUT_MS=4000
DELIVERY_HAVERSINE_FALLBACK_FACTOR=1.3
GEOCODING_BASE_URL=https://photon.komoot.io

# =============================================================================
# Recommendation engine
# =============================================================================
# Optional offline recommendation trainer. The API needs none of these to serve
# its deterministic fallback ordering.
RECOMMENDATION_TOP_K=200
RECOMMENDATION_TTL_HOURS=36
RECOMMENDATION_MIN_POSITIVE_EVENTS=50
RECOMMENDATION_EPOCHS=25
RECOMMENDATION_GRAPH_BLEND=0.18
RECOMMENDATION_FRESHNESS_BLEND=0.12
RECOMMENDATION_FRESHNESS_HALF_LIFE_DAYS=21
RECOMMENDATION_EVENT_HALF_LIFE_DAYS=60

# =============================================================================
# Campus AI assistant
# =============================================================================
# Campus AI assistant (optional). Without a key, the assistant still runs deep
# system search and returns deterministic, search-grounded replies.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

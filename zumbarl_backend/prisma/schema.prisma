  opportunityId String
  label         String
  fileType      String
  required      Boolean  @default(true)
  sortOrder     Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_required_attachments")
}

model OpportunityActivityEvent {
  id            String   @id @default(cuid())
  opportunityId String
  actorId       String?
  action        String
  note          String?
  metadata      Json?
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("opportunity_activity_events")
}

model OpportunityInvite {
  id            String    @id @default(cuid())
  opportunityId String
  studentId     String
  note          String?
  status        String    @default("sent")
  sentAt        DateTime  @default(now())
  acceptedAt    DateTime?
  respondedAt   DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([studentId])
  @@index([status])
  @@map("opportunity_invites")
}

model Bid {
  id              String    @id @default(cuid())
  opportunityId   String
  studentId       String
  status          String    @default("pending")
  coverNote       String?
  proposal        String?
  bidAmount       Float?
  currency        String    @default("KES")
  deliveryTime    String?
  intentId        String?
  intentLabel     String?
  inviteId        String?
  questionAnswers Json?
  attachments     Json?
  appliedAt       DateTime  @default(now())
  respondedAt     DateTime?
  rejectionReason String?
  projectId       String?
  metadata        Json?

  opportunity Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     StudentProfile          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissions OpportunitySubmission[]
  interview   OpportunityInterview?

  @@unique([opportunityId, studentId])
  @@index([opportunityId])
  @@index([studentId])
  @@index([status])
  @@map("bids")
}

model OpportunityInterview {
  id                  String    @id @default(cuid())
  bidId               String    @unique
  opportunityId       String
  studentId           String
  scheduledById       String?
  interviewType       String    @default("video")
  scheduledAt         DateTime
  durationMinutes     Int       @default(30)
  timezone            String    @default("Africa/Nairobi")
  meetingOption       String    @default("generated")
  meetingUrl          String?
  note                String?
  status              String    @default("pending")
  studentResponseNote String?
  proposedAt          DateTime?
  respondedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([studentId])
  @@index([status])
  @@index([scheduledAt])
  @@map("opportunity_interviews")
}

model OpportunitySubmission {
  id             String    @id @default(cuid())
  opportunityId  String
  scopeItemId    String?
  bidId          String?
  studentId      String
  title          String?
  description    String?
  fileUrls       String[]
  fileKeys       String[]
  evidence       Json?
  status         String    @default("submitted")
  submittedAt    DateTime  @default(now())
  revisionCount  Int       @default(0)
  lastRevisionAt DateTime?
  acceptedAt     DateTime?

  opportunity Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  scopeItem   OpportunityScopeItem? @relation(fields: [scopeItemId], references: [id], onDelete: SetNull)
  bid         Bid?                  @relation(fields: [bidId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([scopeItemId])
  @@index([bidId])
  @@index([studentId])
  @@index([status])
  @@map("opportunity_submissions")
}

model OpportunityRating {
  id            String @id @default(cuid())
  opportunityId String
  studentId     String
  companyId     String

  // Six dimensions — all 1.0 to 5.0
  communicationScore   Float
  timeManagementScore  Float
  skillsScore          Float
  deliveryQualityScore Float
  creativityScore      Float
  professionalismScore Float
  overallScore         Float // computed average

  briefAdherence Float // 1–5: did work match the brief
  revisionCycles Int // how many revision rounds
  wouldHireAgain Boolean
  publicFeedback String? // visible on student profile
  privateNote    String? // company-only internal note
  isHeld         Boolean  @default(false) // held during safety review
  ratedAt        DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([studentId])
  @@index([companyId])
  @@map("opportunity_ratings")
}

// =============================================================================
// ZUMBARL SCORE
// =============================================================================

model ZumbarlScore {
  id           String    @id @default(cuid())
  studentId    String    @unique
  currentScore Float     @default(0)
  tier         ScoreTier @default(BRONZE)
  confidence   String    @default("PROVISIONAL")

  // Sub-scores (0–100 each)
  qualityScore         Float @default(0)
  volumeScore          Float @default(0)
  loyaltyScore         Float @default(0)
  trustScore           Float @default(0)
  deliveryScore        Float @default(0)
  reliabilityScore     Float @default(0)
  professionalismScore Float @default(0)
  relationshipScore    Float @default(0)

  // Raw inputs for calculator
  avgRating              Float @default(0)
  deliveryRate           Float @default(0)
  totalGigsCompleted     Int   @default(0)
  repeatClientRate       Float @default(0)
  endorsementCount       Int   @default(0)
  effectiveEngagements   Float @default(0)
  uniqueClients          Int   @default(0)
  conservativeLowerBound Float @default(0)

  // Penalty flags
  deliveryPenaltyActive Boolean @default(false)
  qualityGateActive     Boolean @default(true) // true until 3 gigs done
  isUnderReview         Boolean @default(false)
  isRestricted          Boolean @default(false)

  // Refresh cycle
  lastRefreshedAt  DateTime?
  nextRefreshAt    DateTime?
  refreshCycleDays Int       @default(18)

  // Momentum
  previousScore  Float?
  scoreVelocity  Float? // points per refresh cycle
  trendDirection String? // UP | FLAT | DOWN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  snapshots ScoreSnapshot[]

  @@map("zumbarl_scores")
}

model ScoreSnapshot {
  id                     String    @id @default(cuid())
  scoreId                String
  studentId              String
  score                  Float
  tier                   ScoreTier
  qualityScore           Float
  volumeScore            Float
  loyaltyScore           Float
  trustScore             Float
  deliveryScore          Float
  confidence             String    @default("PROVISIONAL")
  reliabilityScore       Float     @default(0)
  professionalismScore   Float     @default(0)
  relationshipScore      Float     @default(0)
  effectiveEngagements   Float     @default(0)
  uniqueClients          Int       @default(0)
  totalEngagements       Int       @default(0)
  conservativeLowerBound Float     @default(0)
  categoryScores         Json?
  isUnderReview          Boolean   @default(false)
  isRestricted           Boolean   @default(false)
  snapshotReason         String // REFRESH | GIG_COMPLETED | ENDORSEMENT | PENALTY
  createdAt              DateTime  @default(now())

  zumbarlScore ZumbarlScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
  @@map("score_snapshots")
}

// One immutable scoring unit per completed student engagement. Deliverables,
// tasks, reviews and payouts feed this row; they do not award points separately.
model EngagementOutcome {
  id            String   @id @default(cuid())
  opportunityId String
  studentId     String
  companyId     String
  projectId     String?
  category      String
  completedAt   DateTime

  contractValueKes       Float
  categoryMedianValueKes Float
  isVerified             Boolean @default(false)
  raterIsCredible        Boolean @default(true)

  deliveryQualityRating Float
  briefAdherenceRating  Float
  categoryRubricScore   Float   @default(0.5)
  firstPassAccepted     Boolean @default(false)

  completedWithinDeadline     Boolean
  deadlineMissWasStudentFault Boolean @default(false)
  submissionWasComplete       Boolean @default(true)
  studentCancelledMidway      Boolean @default(false)
  attributableRevisionCount   Int     @default(0)
  contractRevisionAllowance   Int     @default(2)

  communicationRating         Float
  conductRating               Float
  disputeRaised               Boolean @default(false)
  disputeUpheldAgainstStudent Boolean @default(false)

  wouldHireAgain           Boolean
  isRepeatEngagement       Boolean @default(false)
  clientSatisfactionRating Float
  publicFeedback           String?
  categoryRubricEvidence   Json?

  isQuarantined  Boolean  @default(false)
  quarantineNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunity Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([studentId, opportunityId])
  @@index([studentId, completedAt])
  @@index([companyId])
  @@index([category])
  @@map("engagement_outcomes")
}

// Denormalised category view used for business-side filtering and matching.
model StudentCategoryScore {
  id          String   @id @default(cuid())
  studentId   String
  category    String
  score       Float
  engagements Int
  confidence  String
  updatedAt   DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, category])
  @@index([category, score])
  @@map("student_category_scores")
}

model SkillLevel_ {
  id             String     @id @default(cuid())
  studentId      String
  skillName      String
  level          SkillLevel @default(BEGINNER)
  verifiedByGigs Int        @default(0)
  lastAdvancedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillName])
  @@index([studentId])
  @@map("skill_levels")
}

model SkillCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  status      String   @default("active")
  isSeed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills Skill[]

  @@index([status])
  @@map("skill_categories")
}

model Skill {
  id                String   @id @default(cuid())
  categoryId        String?
  name              String
  slug              String   @unique
  description       String?
  status            String   @default("active")
  source            String   @default("seed")
  mergedIntoSkillId String?
  usageCount        Int      @default(0)
  createdByUserId   String?
  isSeed            Boolean  @default(false)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category          SkillCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  mergedIntoSkill   Skill?                  @relation("MergedSkills", fields: [mergedIntoSkillId], references: [id], onDelete: SetNull)
  mergedSkills      Skill[]                 @relation("MergedSkills")
  aliases           SkillAlias[]
  opportunitySkills OpportunitySkill[]
  studentSkills     StudentSkill[]
  competencies      Competency[]
  evergreenPrograms EvergreenProgramSkill[]

  @@index([categoryId])
  @@index([status])
  @@index([source])
  @@index([usageCount])
  @@map("skills")
}

model SkillAlias {
  id        String   @id @default(cuid())
  skillId   String
  name      String
  slug      String   @unique
  source    String   @default("system")
  isSeed    Boolean  @default(false)
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@map("skill_aliases")
}

model StudentSkill {

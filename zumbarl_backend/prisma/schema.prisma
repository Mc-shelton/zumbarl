  prerequisiteStep CareerRoadmapStep @relation("RoadmapStepPrerequisiteSource", fields: [prerequisiteStepId], references: [id], onDelete: Cascade)

  @@unique([stepId, prerequisiteStepId])
  @@index([prerequisiteStepId])
  @@map("roadmap_step_prerequisites")
}

model LearningResource {
  id           String   @id @default(cuid())
  title        String
  description  String?
  resourceType String   @default("ARTICLE")
  url          String?
  provider     String?
  status       String   @default("PUBLISHED")
  content      Json?
  practice     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competencies        LearningResourceCompetency[]
  roadmapSteps        CareerRoadmapStepResource[]
  practiceSubmissions LearningPracticeSubmission[]

  @@index([status])
  @@map("learning_resources")
}

// Student-owned libraries, study groups and circulating learning material.
// These are deliberately separate from LearningResource, which is curated
// lesson content attached to career-roadmap checkpoints.
model KnowledgeSpace {
  id             String   @id @default(cuid())
  ownerStudentId String?
  type           String // LIBRARY | GROUP
  groupType      String? // STUDY_GROUP | CLUB | ASSOCIATION | SOCIETY | CHAMA
  name           String
  slug           String   @unique
  description    String?
  campusId       String?

  portfolioItemId   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  placement  Placement   @relation(fields: [placementId], references: [id], onDelete: Restrict)
  competency Competency? @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@index([placementId, status])
  @@index([competencyId])
  @@map("placement_evidence")
}

model PlacementEvaluation {
  id             String   @id @default(cuid())
  placementId    String
  evaluatorId    String
  evaluatorType  String
  rubricScores   Json
  narrative      String
  recommendation String?
  visibility     String   @default("SHARED")
  submittedAt    DateTime @default(now())

  placement Placement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@unique([placementId, evaluatorId, evaluatorType])
  @@index([placementId])
  @@map("placement_evaluations")
}

model PlacementAmendment {
  id                String    @id @default(cuid())
  placementId       String
  version           Int
  proposedById      String
  reason            String
  changes           Json
  status            String    @default("PROPOSED")
  studentAcceptedAt DateTime?
  companyAcceptedAt DateTime?
  appliedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  placement Placement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@unique([placementId, version])
  @@index([placementId, status])
  @@map("placement_amendments")
}

model PlacementStatusEvent {
  id          String           @id @default(cuid())
  placementId String
  fromStatus  PlacementStatus?
  toStatus    PlacementStatus
  actorId     String
  reason      String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  placement Placement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@index([placementId, createdAt])
  @@map("placement_status_events")
}

model PlacementSupportRequest {
  id             String    @id @default(cuid())
  placementId    String
  requestedById  String
  category       String
  summary        String
  privateDetails String?
  status         String    @default("OPEN")
  assignedToId   String?
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  placement Placement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@index([placementId, status])
  @@index([status, createdAt])
  @@map("placement_support_requests")
}

model EvergreenEntitlement {
  id              String                     @id @default(cuid())
  companyId       String
  sourceInvoiceId String?                    @unique
  planCode        String
  status          EvergreenEntitlementStatus @default(PENDING)
  programLimit    Int
  seatLimit       Int
  validFrom       DateTime
  validUntil      DateTime
  sourceType      String
  sourceReference String
  confirmedById   String?
  confirmedAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceInvoice EvergreenInvoice? @relation("InvoiceEntitlement", fields: [sourceInvoiceId], references: [id], onDelete: Restrict)

  @@index([companyId, status, validUntil])
  @@map("evergreen_entitlements")
}

model EvergreenInvoice {
  id                String                 @id @default(cuid())
  companyId         String
  invoiceNumber     String                 @unique
  amount            Decimal                @db.Decimal(14, 2)
  currency          String                 @default("KES") @db.VarChar(3)
  status            EvergreenInvoiceStatus @default(DRAFT)
  externalReference String?
  issuedAt          DateTime?
  dueAt             DateTime?
  confirmedAt       DateTime?
  confirmedById     String?
  refundedAt        DateTime?
  refundReason      String?
  idempotencyKey    String?                @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entitlement EvergreenEntitlement? @relation("InvoiceEntitlement")

  @@index([companyId, status])
  @@map("evergreen_invoices")
}

model EvergreenOverride {
  id           String                  @id @default(cuid())
  subjectType  String
  subjectId    String
  policy       String
  reason       String
  approvedById String
  status       EvergreenOverrideStatus @default(ACTIVE)
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime                @default(now())

  @@index([subjectType, subjectId, policy, status, expiresAt])
  @@map("evergreen_overrides")
}

model EvergreenMatchRun {
  id               String                  @id @default(cuid())
  cohortId         String
  algorithmVersion String
  inputSnapshot    Json
  status           EvergreenMatchRunStatus @default(PENDING)
  eligibleCount    Int                     @default(0)
  matchedCount     Int                     @default(0)
  failureReason    String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())

  cohort EvergreenCohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  @@index([cohortId, createdAt])
  @@index([status, createdAt])
  @@map("evergreen_match_runs")
}

model EvergreenMentorshipAlternative {
  id           String   @id @default(cuid())
  companyId    String
  studentId    String
  type         String
  description  String
  completedAt  DateTime
  evidence     Json?
  approvedById String
  approvedAt   DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([companyId, studentId, completedAt])
  @@map("evergreen_mentorship_alternatives")
}

model OutboxEvent {
  id             String                  @id @default(cuid())
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  status         OutboxEventStatus       @default(PENDING)
  idempotencyKey String                  @unique
  availableAt    DateTime                @default(now())
  claimedAt      DateTime?
  claimedBy      String?
  deliveredAt    DateTime?
  attemptCount   Int                     @default(0)
  lastError      String?
  createdAt      DateTime                @default(now())
  receipts       OutboxConsumerReceipt[]

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model OutboxConsumerReceipt {
  id          String   @id @default(cuid())
  eventId     String
  consumer    String
  processedAt DateTime @default(now())
  result      Json?

  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, consumer])
  @@index([consumer, processedAt])
  @@map("outbox_consumer_receipts")
}

model EvergreenIdempotencyKey {
  id           String    @id @default(cuid())
  actorId      String
  operation    String
  key          String
  requestHash  String
  responseCode Int?
  responseBody Json?
  resourceId   String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@unique([actorId, operation, key])
  @@index([expiresAt])
  @@map("evergreen_idempotency_keys")
}

model EvergreenWorkerLease {
  name        String   @id
  ownerId     String
  lockedUntil DateTime
  heartbeatAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
  @@map("evergreen_worker_leases")
}

model EvergreenJobRun {
  id            String    @id @default(cuid())
  jobName       String
  replayOfId    String?
  status        String    @default("RUNNING")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  attemptCount  Int       @default(1)
  result        Json?
  failureReason String?
  requestedById String?

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@map("evergreen_job_runs")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  config      Json?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model Certificate {
  id               String    @id @default(cuid())
  studentId        String
  type             String // SKILL_VERIFIED | TIER_ACHIEVED | ZUMBARL_GRADUATE
  title            String
  skillName        String?
  level            String?
  fileUrl          String? // signed PDF URL
  fileKey          String?
  verificationHash String?   @unique // tamper-evident
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("certificates")
}

// =============================================================================
// FINANCE
// =============================================================================

model Wallet {
  id             String   @id @default(cuid())
  studentId      String
  type           String   @default("MAIN") // MAIN | SAVINGS
  balance        Float    @default(0)
  pendingBalance Float    @default(0) // in escrow, not yet released
  currency       String   @default("KES")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([studentId])
  @@map("wallets")
}

model CompanyWallet {
  id        String   @id @default(cuid())
  companyId String   @unique
  balance   Float    @default(0)
  currency  String   @default("KES")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("company_wallets")
}

model Transaction {
  id              String            @id @default(cuid())
  walletId        String?
  companyWalletId String?
  chamaWalletId   String?
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Float
  currency        String            @default("KES")
  platformFee     Float             @default(0)
  netAmount       Float // amount - platformFee
  reference       String            @unique @default(cuid())
  mpesaRef        String? // Safaricom transaction ID
  mpesaDirection  MpesaDirection?
  description     String?
  opportunityId   String?
  metadata        Json? // flexible extra data
  processedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime          @default(now())

  wallet        Wallet?        @relation(fields: [walletId], references: [id])
  companyWallet CompanyWallet? @relation(fields: [companyWalletId], references: [id])
  chamaWallet   ChamaWallet?   @relation(fields: [chamaWalletId], references: [id])

  @@index([walletId])
  @@index([companyWalletId])
  @@index([opportunityId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model OpportunityEscrowHold {
  id             String    @id @default(cuid())
  opportunityId  String
  companyId      String
  studentId      String?
  amount         Float
  currency       String    @default("KES")
  status         String    @default("HELD") // HELD | RELEASED | REFUNDED | DISPUTED
  heldAt         DateTime  @default(now())
  releasedAt     DateTime?
  refundedAt     DateTime?
  transactionRef String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([companyId])
  @@index([studentId])
  @@map("opportunity_escrow_holds")
}

model MicroAdvance {
  id            String    @id @default(cuid())
  studentId     String
  opportunityId String // the opportunity whose payout backs this advance
  amount        Float
  currency      String    @default("KES")
  status        String    @default("ACTIVE") // ACTIVE | REPAID | DEFAULTED
  issuedAt      DateTime  @default(now())
  repaidAt      DateTime?
  repaymentRef  String?

  @@index([studentId])
  @@index([opportunityId])
  @@map("micro_advances")
}

// =============================================================================
// CHAMAS (GROUP SAVINGS)
// =============================================================================

model Chama {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  campusId            String
  contributionPercent Float    @default(10) // % of each gig payout
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members           ChamaMember[]
  wallet            ChamaWallet?
  whitelistedPayees ChamaWhitelistedPayee[]

  @@index([campusId])
  @@map("chamas")
}

model ChamaMember {
  id               String   @id @default(cuid())
  chamaId          String
  studentId        String
  isAdmin          Boolean  @default(false)
  totalContributed Float    @default(0)
  joinedAt         DateTime @default(now())

  chama   Chama          @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([chamaId, studentId])
  @@index([chamaId])
  @@index([studentId])
  @@map("chama_members")
}

model ChamaWallet {
  id        String   @id @default(cuid())
  chamaId   String   @unique
  balance   Float    @default(0)
  currency  String   @default("KES")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chama        Chama         @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("chama_wallets")
}

model ChamaWhitelistedPayee {
  id        String   @id @default(cuid())
  chamaId   String
  name      String
  phone     String
  type      String // LANDLORD | HOSTEL | SUPPLIER | MEMBER | OTHER
  addedBy   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  chama Chama @relation(fields: [chamaId], references: [id], onDelete: Cascade)

  @@index([chamaId])
  @@map("chama_whitelisted_payees")
}

// =============================================================================
// SAFETY (SILOED — no foreign key references to this from other services)
// =============================================================================

model SafetyReport {
  id             String             @id @default(cuid())
  reporterUserId String // not a FK — siloed by design
  reportedEntity String // company ID or user ID
  entityType     String // COMPANY | USER
  opportunityId  String? // opportunity context if applicable
  type           SafetyReportType
  status         SafetyReportStatus @default(RECEIVED)
  description    String?
  locationLat    Float?
  locationLng    Float?
  isAnonymous    Boolean            @default(false)
  assignedTo     String? // safety officer user ID
  resolvedAt     DateTime?
  resolution     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([reporterUserId])
  @@index([status])
  @@index([opportunityId])
  @@map("safety_reports")
}

// =============================================================================
// NOTIFICATIONS & MESSAGING
// =============================================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // GIG_MATCH | SCORE_REFRESH | ENDORSEMENT | SAFETY | etc.
  title     String
  body      String
  data      Json? // deep link data
  isRead    Boolean   @default(false)
  readAt    DateTime?
  sentVia   String[] // IN_APP | WHATSAPP | SMS | EMAIL
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ProjectTeamInvite {
  id            String    @id @default(cuid())
  projectId     String
  inviterUserId String
  inviteeUserId String
  role          String    @default("Contributor")
  note          String?
  status        String    @default("pending")
  sentAt        DateTime  @default(now())
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  inviter User @relation("ProjectTeamInviteSender", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee User @relation("ProjectTeamInviteRecipient", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, inviteeUserId])
  @@index([projectId])
  @@index([inviteeUserId, status])
  @@map("project_team_invites")
}

model ProjectTeamMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("Contributor")
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_team_members")
}

model CallSession {
  id            String    @id @default(cuid())
  callerId      String
  recipientId   String
  opportunityId String?
  callType      String
  roomUrl       String
  status        String    @default("ringing")
  expiresAt     DateTime
  acceptedAt    DateTime?
  declinedAt    DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  caller    User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  recipient User @relation("CallRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([callerId, status])
  @@index([recipientId, status])
  @@index([expiresAt])
  @@map("call_sessions")
}

model Message {
  id            String    @id @default(cuid())
  opportunityId String?
  senderId      String
  recipientId   String
  body          String
  fileUrls      String[]
  context       Json?
  deliveredAt   DateTime?
  isRead        Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])

  @@index([opportunityId])
  @@index([senderId])
  @@index([recipientId])
  @@map("messages")
}

// =============================================================================
// PLATFORM ADMIN
// =============================================================================

model CampusManager {
  id        String   @id @default(cuid())
  userId    String   @unique
  campusId  String
  createdAt DateTime @default(now())

  campus Campus @relation(fields: [campusId], references: [id])

  @@map("campus_managers")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// API WORKFLOW RECORDS
// =============================================================================

model WorkflowRecord {
  id         String   @id @default(cuid())
  collection String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([collection])
  @@index([collection, createdAt])
  @@map("workflow_records")
}

// =============================================================================
// RECOMMENDATIONS
// =============================================================================

model RecommendationEvent {
  id         String   @id @default(cuid())
  studentId  String
  surface    String
  entityType String
  entityId   String
  eventType  String
  reward     Float
  position   Int?
  sessionId  String?
  features   Json?
  metadata   Json?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, surface, occurredAt])
  @@index([surface, entityType, entityId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("recommendation_events")
}

model RecommendationModelArtifact {
  id            String    @id @default(cuid())
  surface       String
  version       String
  algorithm     String
  status        String
  metrics       Json?
  featureSchema Json?
  trainedAt     DateTime
  activatedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  scores RecommendationScore[]

  @@unique([surface, version])
  @@index([surface, status, activatedAt])
  @@map("recommendation_model_artifacts")
}

model RecommendationScore {
  id              String   @id @default(cuid())
  studentId       String
  surface         String
  entityType      String
  entityId        String
  score           Float
  rank            Int
  reason          Json?
  modelArtifactId String
  generatedAt     DateTime @default(now())
  expiresAt       DateTime

  student       StudentProfile              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  modelArtifact RecommendationModelArtifact @relation(fields: [modelArtifactId], references: [id], onDelete: Cascade)

  @@unique([studentId, surface, entityType, entityId])
  @@index([studentId, surface, rank])
  @@index([surface, entityType, entityId])
  @@index([expiresAt])
  @@map("recommendation_scores")
}

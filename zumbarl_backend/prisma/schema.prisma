model CareerStageProgress {
  id                  String        @id @default(cuid())
  studentId           String
  stage               PipelineStage
  status              String        @default("LOCKED") // LOCKED | IN_PROGRESS | COMPLETED
  progressPercent     Float         @default(0)
  projectsCompleted   Int           @default(0)
  companiesWorkedWith Int           @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([studentId, stage])
  @@index([studentId])
  @@map("career_stage_progress")
}

model CareerRoadmap {
  id                    String   @id @default(cuid())
  campusId              String?
  title                 String
  slug                  String   @unique
  description           String
  careerFamily          String
  level                 String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  estimatedWeeks        Int      @default(4)
  coverImageUrl         String?
  skills                String[] @default([])
  outcomes              String[] @default([])
  status                String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  sortOrder             Int      @default(0)
  version               Int      @default(1)
  intents               String[] @default([])
  evidenceWeight        Int      @default(80)
  testWeight            Int      @default(20)
  verificationThreshold Int      @default(90)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campus      Campus?                    @relation(fields: [campusId], references: [id])
  steps       CareerRoadmapStep[]
  enrollments StudentRoadmapEnrollment[]

  @@index([campusId])
  @@index([careerFamily, status])
  @@map("career_roadmaps")
}

model CareerRoadmapStep {
  id             String   @id @default(cuid())
  roadmapId      String
  title          String
  description    String
  stepType       String   @default("LEARNING") // LEARNING | PROJECT | QUIZ | PORTFOLIO | MENTORSHIP
  resourceUrl    String?
  evidenceType   String?
  estimatedHours Float?
  required       Boolean  @default(true)
  sortOrder      Int      @default(0)
  assessment     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  roadmap             CareerRoadmap                 @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  competencies        CareerRoadmapStepCompetency[]
  resources           CareerRoadmapStepResource[]
  progress            StudentRoadmapStepProgress[]
  evidence            RoadmapEvidence[]
  assessmentAttempts  RoadmapAssessmentAttempt[]
  practiceSubmissions LearningPracticeSubmission[]
  prerequisites       RoadmapStepPrerequisite[]     @relation("RoadmapStepPrerequisiteTarget")
  dependants          RoadmapStepPrerequisite[]     @relation("RoadmapStepPrerequisiteSource")

  @@index([roadmapId])
  @@map("career_roadmap_steps")
}

model StudentRoadmapEnrollment {
  id               String    @id @default(cuid())
  studentId        String
  roadmapId        String
  status           String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | PAUSED
  progressPercent  Float     @default(0)
  currentStepOrder Int       @default(0)
  completedStepIds String[]  @default([])
  evidenceUrls     String[]  @default([])
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  intent           String    @default("explore")
  lockedAt         DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student             StudentProfile               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roadmap             CareerRoadmap                @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  stepProgress        StudentRoadmapStepProgress[]
  evidence            RoadmapEvidence[]
  assessmentAttempts  RoadmapAssessmentAttempt[]
  practiceSubmissions LearningPracticeSubmission[]
  transitions         RoadmapStageTransition[]

  @@unique([studentId, roadmapId])
  @@index([studentId])
  @@index([roadmapId])
  @@map("student_roadmap_enrollments")
}

model Competency {
  id          String   @id @default(cuid())
  skillId     String?
  name        String
  slug        String   @unique
  description String?
  level       String   @default("FOUNDATION")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


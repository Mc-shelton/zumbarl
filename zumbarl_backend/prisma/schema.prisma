// A student's declared contribution to one deliverable of a team project.
// Declaring is public: it says what someone intends to deliver, drives the
// workload view both sides see, and is the input to the payout split.
model DeliverableTask {
  id                     String    @id @default(cuid())
  projectId              String
  scopeItemId            String?
  // Milestone mode nests the work: milestone -> deliverable -> task. A task
  // carries both links so the board can filter by either without a join.
  milestoneId            String?
  milestoneDeliverableId String?
  // Scheduling overlay only. Moving a task between sprints must never change
  // who is credited for it.
  sprintId               String?
  title                  String
  description            String?
  // null owner means the task sits in the shared pool for anyone to claim.
  ownerId                String?
  declaredById           String?
  weight                 Int       @default(1)
  // todo | in_progress | blocked | submitted | done | dropped
  // `done` is granted by the business approving the submission that covers the
  // task; a student can only take it as far as `submitted`.
  status                 String    @default("todo")
  // The deliverable submission this task was included in.
  submissionId           String?
  blockedByIds           String[]  @default([])
  // External blockers (see DeliverableDependency) live alongside task blockers:
  // work stalls on a missing client asset as often as on a teammate.
  blockedByDependencyIds String[]  @default([])
  evidence               Json?
  droppedReason          String?
  // Interim settlement: a task is paid once its work is approved, so a milestone
  // running for months does not leave people unpaid until the very end.
  paidAmount             Float?
  paidAt                 DateTime?
  declaredAt             DateTime  @default(now())
  claimedAt              DateTime?
  blockedAt              DateTime?
  doneAt                 DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  scopeItem OpportunityScopeItem? @relation(fields: [scopeItemId], references: [id], onDelete: Cascade)
  owner     StudentProfile?       @relation("DeliverableTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([scopeItemId])
  @@index([ownerId])
  @@index([status])
  @@map("deliverable_tasks")
}

// Deliverable-scoped conversation and working files. Kept apart from project
// messages so a note about the brand book stays with the brand book, and apart
// from submissions so drafts are not mistaken for delivered work.
model DeliverableNote {
  id          String   @id @default(cuid())
  projectId   String
  scopeItemId String?
  authorId    String?
  authorName  String?
  body        String
  // note | file
  kind        String   @default("note")
  files       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([scopeItemId])
  @@map("deliverable_notes")
}

// A deliverable inside a milestone. Milestone briefs define milestones as scope
// items; the team breaks each one into deliverables, and each deliverable into
// declared tasks. Plotted on its own timeline track, independent of milestones.
model MilestoneDeliverable {
  id                 String    @id @default(cuid())
  projectId          String
  milestoneId        String
  title              String
  description        String?
  // Mirrors how a deliverable is defined in the opportunity brief, so the team
  // agrees the same things up front: what counts as done and how it is proven.
  workflow           String?
  requirement        String?
  submissionMethod   String?
  evidenceRequired   String?
  acceptanceCriteria String?
  sequence           Int       @default(1)
  // A deliverable carries its own price. The sum of a milestone's deliverable
  // prices is what it has committed, which can drift past the milestone budget
  // as scope is added mid-flight.
  budgetAmount       Float     @default(0)
  // pending | in_progress | submitted | approved | dormant
  // `dormant` means this deliverable pushed the milestone past its budget and is
  // parked: no tasks can be added until the business adds funds.
  status             String    @default("pending")
  startsAt           DateTime?
  dueAt              DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([projectId])
  @@index([milestoneId])
  @@map("milestone_deliverables")
}

// A time-boxed slice of work. Tasks are assigned into it; its span on the
// timeline is its own window, and the board filters to it by default.
model ProjectSprint {
  id          String    @id @default(cuid())
  projectId   String
  // Deprecated compatibility column. New and returned sprints are project-global.
  milestoneId String?
  name        String
  goal        String?
  sequence    Int       @default(1)
  // planned | active | completed
  status      String    @default("planned")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([milestoneId])
  @@map("project_sprints")
}

// Per-project rules the business controls: who may join as a non-earning
// contributor, and what share of their own contribution each such role converts
// into. The workload record is never changed by this - only what it pays.
model ProjectSettings {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  allowInterns       Boolean  @default(false)
  allowAttachees     Boolean  @default(false)
  // { intern: 0-100, attachee: 0-100 } - percent of their own earned share.
  roleEarningFactors Json?
  sprintCadence      String?
  catchupCadence     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("project_settings")
}

// Something outside the team that work is waiting on: a brand asset from the
// client, a login from the business, a third-party approval. Tracked like a task
// blocker so "we are stuck" is visible to the business instead of being buried
// in a chat message.
model DeliverableDependency {
  id           String    @id @default(cuid())
  projectId    String
  scopeItemId  String?
  label        String
  note         String?
  // business | client | external | other
  party        String    @default("business")
  // open | resolved
  status       String    @default("open")
  raisedById   String?
  raisedByName String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
  @@index([scopeItemId])
  @@index([status])
  @@map("deliverable_dependencies")
}

// The workload split for one deliverable, frozen when the team submits it.
// Payout reads this snapshot, never the live tasks, so weights edited after a
// submission can never move money that was already agreed.
model DeliverableSplitLock {
  id           String    @id @default(cuid())
  projectId    String
  scopeItemId  String
  // [{ studentId, weight, sharePercent }]
  shares       Json
  confirmedBy  String[]  @default([])
  contributors String[]  @default([])
  // pending | confirmed
  status       String    @default("pending")
  lockedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([projectId, scopeItemId])
  @@index([projectId])
  @@map("deliverable_split_locks")
}


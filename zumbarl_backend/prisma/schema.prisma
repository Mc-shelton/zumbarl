// =============================================================================
// ZUMBARL — PRISMA SCHEMA
// Core tables only. Campus life, marketplace, and events schemas are separate.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  STUDENT_STANDARD
  STUDENT_TRANSITION
  STUDENT_ALUMNI
  CAMPUS_AMBASSADOR
  COMPANY_STANDARD
  COMPANY_PIPELINE_PARTNER
  COMPANY_HR_MANAGER
  COMPANY_HIRING_MANAGER
  COMPANY_VIEWER
  SAFETY_OFFICER
  OPERATIONS_MANAGER
  CAMPUS_MANAGER
  FINANCE_OFFICER
  CONTENT_MODERATOR
  SUPER_ADMIN
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum PipelineStage {
  EXPLORE_FOUNDATION // Stage 1
  BUILD_APPLY // Stage 2
  GROW_SPECIALIZE // Stage 3
  LEAD_IMPACT // Stage 4
  ADVANCE_MENTOR // Stage 5
}

enum PipelineRelationshipStatus {
  EARLY
  WARMING_UP
  ACTIVE
  PLACEMENT_READY
  PLACED
  INACTIVE
}

enum TransactionType {
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REFUND
  STUDENT_PAYOUT
  PLATFORM_FEE
  CHAMA_CONTRIBUTION
  CHAMA_DISBURSEMENT
  CHAMA_INVESTMENT
  MICRO_ADVANCE
  ADVANCE_REPAYMENT
  COMPANY_PAYMENT
  RESOURCE_PURCHASE
  RESOURCE_SALE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum MpesaDirection {
  STK_PUSH // Company paying in
  B2C // Student payout
  C2B // Chama contribution
}

enum ScoreTier {
  PROVISIONAL // no public score until confidence gates are met
  BRONZE // below 60
  SILVER // 60–74
  GOLD // 75–89 plus evidence gates
  PLATINUM // 90–100 plus evidence and reliability gates
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SafetyReportType {
  FEELING_UNSAFE
  INAPPROPRIATE_BEHAVIOUR
  HARASSMENT
  FRAUD
  OTHER
}

enum SafetyReportStatus {
  RECEIVED
  UNDER_REVIEW
  RESOLVED
  ESCALATED
  CLOSED
}

enum PlacementType {
  INTERNSHIP
  ATTACHMENT
  FULL_TIME
  CONTRACT
}

enum EvergreenProgramStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  ACTIVE
  PAUSED
  SUSPENDED
  ARCHIVED
}

enum EvergreenCohortStatus {
  SCHEDULED
  OPEN
  MATCHING
  INTERVIEWING
  FILLED
  PARTIALLY_FILLED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum EvergreenCandidateStatus {
  MATCHED
  INVITED
  APPLIED
  SHORTLISTED
  INTERVIEWING
  OFFERED
  ACCEPTED
  STARTED
  COMPLETED
  DECLINED
  WITHDRAWN
  REJECTED
  OFFER_EXPIRED
  TERMINATED
}

enum EvergreenOfferStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum PlacementStatus {
  PENDING_ONBOARDING
  READY
  ACTIVE
  COMPLETION_REVIEW
  COMPLETED
  DEFERRED
  CANCELLED_BEFORE_START
  TERMINATED
  DISPUTED
}

enum EvergreenWorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum EvergreenRecurrenceType {
  NONE
  WEEKLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum EvergreenEntitlementStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum EvergreenInvoiceStatus {
  DRAFT
  ISSUED
  CONFIRMED
  REFUNDED
  VOID
}

enum EvergreenOverrideStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum EvergreenMatchRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum PlacementEvidenceStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

// =============================================================================
// USERS & AUTH
// =============================================================================

model User {
  id           String    @id @default(cuid())
  name         String?
  firstName    String?
  lastName     String?
  username     String?   @unique
  email        String    @unique
  studentEmail String?   @unique // university email
  phone        String    @unique
  passwordHash String
  role         UserRole  @default(STUDENT_STANDARD)
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  studentProfile             StudentProfile?
  companyContact             CompanyContact?
  sessions                   Session[]
  notifications              Notification[]
  sentMessages               Message[]                @relation("SentMessages")
  receivedMessages           Message[]                @relation("ReceivedMessages")
  outgoingCalls              CallSession[]            @relation("CallCaller")
  incomingCalls              CallSession[]            @relation("CallRecipient")
  uploadedFiles              UploadedFile[]
  sentProjectTeamInvites     ProjectTeamInvite[]      @relation("ProjectTeamInviteSender")
  receivedProjectTeamInvites ProjectTeamInvite[]      @relation("ProjectTeamInviteRecipient")
  projectTeamMemberships     ProjectTeamMember[]
  marketplaceOffersMade      MarketplaceOffer[]       @relation("MarketplaceOfferBuyer")
  marketplaceOffersReceived  MarketplaceOffer[]       @relation("MarketplaceOfferSeller")
  managedProfiles            ManagedProfileManager[]
  followedManagedProfiles    ManagedProfileFollower[]
  marketplaceShopAssignments MarketplaceShopManager[]

  @@index([email])
  @@index([phone])
  @@index([username])
  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// =============================================================================
// STUDENT PROFILE
// =============================================================================

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       String?
  locationCity String   @default("Nairobi")
  avatarUrl    String?
  bio          String?

  // Campus
  campusId           String
  courseId           String
  yearJoined         Int
  courseDuration     Int // years
  expectedGraduation DateTime
  studentIdNumber    String?

  // Career
  careerPath        String? // e.g. "Marketing & Design"
  currentMode       String  @default("EARN") // EARN | CAREER
  showZumbarlPoints Boolean @default(true)

  // Transition
  transitionUnlockedAt  DateTime?
  alumniWindowExpiresAt DateTime?
  isOpenToHire          Boolean   @default(false)

  // KYC
  kycStatus     KycStatus @default(PENDING)
  kycVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                        User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus                      Campus                           @relation(fields: [campusId], references: [id])
  course                      Course                           @relation(fields: [courseId], references: [id])
  kycDocuments                KycDocument[]
  zumbarl                     ZumbarlScore?
  skillLevels                 SkillLevel_[]
  bids                        Bid[]
  pipelineRelationships       PipelineRelationship[]
  endorsementsReceived        Endorsement[]                    @relation("EndorsementsReceived")
  achievements                Achievement[]
  portfolioItems              PortfolioItem[]
  stories                     StudentStory[]
  posts                       CampusPost[]
  marketplaceShops            MarketplaceShop[]
  marketplaceListings         MarketplaceListing[]
  eventRsvps                  CampusEventRsvp[]
  roadmapEnrollments          StudentRoadmapEnrollment[]
  roadmapEvidence             RoadmapEvidence[]
  roadmapAssessmentAttempts   RoadmapAssessmentAttempt[]
  learningPracticeSubmissions LearningPracticeSubmission[]
  competencyStates            StudentCompetencyState[]
  studentSkills               StudentSkill[]
  engagementOutcomes          EngagementOutcome[]
  categoryScores              StudentCategoryScore[]
  wallets                     Wallet[]
  certificates                Certificate[]
  chamaMembers                ChamaMember[]
  deliverableTasks            DeliverableTask[]                @relation("DeliverableTaskOwner")
  connectStoryReactions       ConnectStoryReaction[]
  connectStoryComments        ConnectStoryComment[]
  connectStories              ConnectStory[]
  knowledgeResources          KnowledgeResource[]              @relation("KnowledgeResourceOwner")
  knowledgeSpaces             KnowledgeSpace[]                 @relation("KnowledgeSpaceOwner")
  knowledgeMemberships        KnowledgeSpaceMembership[]
  knowledgeFollows            KnowledgeSpaceFollower[]
  knowledgeAccesses           KnowledgeResourceAccess[]
  knowledgeRoomsCreated       KnowledgeRoom[]                  @relation("KnowledgeRoomCreator")
  knowledgeRoomMemberships    KnowledgeRoomMembership[]
  knowledgeRoomMessages       KnowledgeRoomMessage[]           @relation("KnowledgeRoomMessageAuthor")
  connectCommentReactions     ConnectStoryCommentReaction[]
  outgoingRelationships       ConnectRelationship[]            @relation("ConnectRelationshipActor")
  incomingRelationships       ConnectRelationship[]            @relation("ConnectRelationshipTarget")
  recommendationEvents        RecommendationEvent[]
  recommendationScores        RecommendationScore[]
  wellbeingPreference         WellbeingPreference?
  wellbeingCheckIns           WellbeingCheckIn[]
  wellbeingResetSessions      WellbeingResetSession[]
  wellbeingConversations      WellbeingConversation[]
  placementAvailability       PlacementAvailability?
  evergreenCandidates         EvergreenCandidate[]
  evergreenOffers             PlacementOffer[]
  placements                  Placement[]
  activePlacementLock         ActivePlacementLock?
  evergreenMentorships        EvergreenMentorshipAlternative[]

  @@index([campusId])
  @@index([kycStatus])
  @@map("student_profiles")
}

model Campus {
  id            String   @id @default(cuid())
  name          String
  branch        String?
  city          String
  locationLabel String?
  latitude      Float?
  longitude     Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  students            StudentProfile[]
  campusManagers      CampusManager[]
  contentItems        CampusContentItem[]
  stories             StudentStory[]
  posts               CampusPost[]
  marketplaceShops    MarketplaceShop[]
  marketplaceListings MarketplaceListing[]
  events              CampusEvent[]
  careerRoadmaps      CareerRoadmap[]
  managedProfile      ManagedProfile?
  wellbeingResources  CampusWellbeingResource[]

  @@map("campuses")
}

model CampusContentItem {
  id          String   @id @default(cuid())
  scope       String
  section     String
  title       String
  subtitle    String?
  description String?
  org         String?
  meta        String?
  value       String?
  imageUrl    String?
  images      String[] @default([])
  href        String?
  actionLabel String?
  tags        String[] @default([])
  payload     Json?
  studentId   String?
  campusId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campus Campus? @relation(fields: [campusId], references: [id])

  @@index([scope, section])
  @@index([studentId])
  @@index([campusId])
  @@map("campus_content_items")
}

model Course {
  id       String @id @default(cuid())
  name     String
  category String // STEM | COMMERCE | ARTS | OTHER
  duration Int // years

  students StudentProfile[]

  @@map("courses")
}

model KycDocument {
  id              String    @id @default(cuid())
  studentId       String
  documentType    String // NATIONAL_ID | STUDENT_ID | CV | OTHER
  fileUrl         String // signed R2 URL
  fileKey         String // R2 object key
  status          KycStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("kyc_documents")
}

// =============================================================================
// CAMPUS EXPERIENCE
// =============================================================================

model StudentStory {
  id            String    @id @default(cuid())
  studentId     String
  campusId      String?
  title         String
  caption       String?
  mediaUrl      String
  mediaType     String    @default("IMAGE") // IMAGE | VIDEO
  thumbnailUrl  String?
  visibility    String    @default("PUBLIC") // PUBLIC | CAMPUS | CONNECTIONS
  status        String    @default("ACTIVE") // ACTIVE | ARCHIVED | REPORTED
  viewCount     Int       @default(0)
  reactionCount Int       @default(0)
  expiresAt     DateTime?
  publishedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campus  Campus?        @relation(fields: [campusId], references: [id])

  @@index([studentId])
  @@index([campusId])
  @@index([status, publishedAt])
  @@map("student_stories")
}

model CampusPost {
  id           String    @id @default(cuid())
  studentId    String?
  campusId     String?
  title        String?
  body         String
  mediaUrls    String[]  @default([])
  tags         String[]  @default([])
  postType     String    @default("GENERAL") // GENERAL | QUESTION | SHOWCASE | ANNOUNCEMENT
  visibility   String    @default("PUBLIC")
  status       String    @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED | REPORTED
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  shareCount   Int       @default(0)
  pinnedUntil  DateTime?
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  campus  Campus?         @relation(fields: [campusId], references: [id])

  @@index([studentId])
  @@index([campusId])
  @@index([postType, status])
  @@index([publishedAt])
  @@map("campus_posts")
}

model MarketplaceShop {
  id              String   @id @default(cuid())
  ownerId         String
  campusId        String?
  name            String
  slug            String   @unique
  tagline         String?
  description     String?
  category        String
  logoUrl         String?
  coverImageUrl   String?
  locationLabel   String?
  deliveryOptions String[] @default([])
  pickupSpots     String[] @default([])
  contactRules    String?
  returnRules     String?
  socialLinks     Json?
  payload         Json?
  ratingAverage   Float    @default(0)
  ratingCount     Int      @default(0)
  orderCount      Int      @default(0)
  status          String   @default("ACTIVE") // DRAFT | ACTIVE | PAUSED | SUSPENDED | ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner    StudentProfile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campus   Campus?                  @relation(fields: [campusId], references: [id])
  listings MarketplaceListing[]
  managers MarketplaceShopManager[]

  @@index([ownerId])
  @@index([campusId])
  @@index([category, status])
  @@map("marketplace_shops")
}

model MarketplaceShopManager {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      String   @default("editor") // owner | admin | editor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop MarketplaceShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId])
  @@map("marketplace_shop_managers")
}

model MarketplaceListing {
  id              String   @id @default(cuid())
  shopId          String?
  sellerId        String
  campusId        String?
  title           String
  description     String
  category        String
  listingType     String   @default("PRODUCT") // PRODUCT | SERVICE | DIGITAL | RENTAL
  condition       String?
  priceAmount     Float
  currency        String   @default("KES")
  images          String[] @default([])
  locationLabel   String?
  deliveryOptions String[] @default([])
  variants        String[] @default([])
  payload         Json?
  status          String   @default("ACTIVE") // DRAFT | ACTIVE | RESERVED | SOLD | ARCHIVED
  stockCount      Int      @default(1)
  viewCount       Int      @default(0)
  savedCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller StudentProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shop   MarketplaceShop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  campus Campus?          @relation(fields: [campusId], references: [id])

  @@index([shopId])
  @@index([sellerId])
  @@index([campusId])
  @@index([category, status])
  @@index([createdAt])
  @@map("marketplace_listings")
}

model MarketingCampaign {
  id                  String    @id @default(cuid())
  seedKey             String?   @unique
  businessId          String?
  title               String
  description         String?
  type                String?
  budgetAmount        Float
  budget              String?
  currency            String    @default("KES")
  platforms           String[]  @default([])
  minimumFollowers    Int       @default(0)
  payoutPerCampaigner Float     @default(0)
  proofRequirements   String[]  @default([])
  materials           Json?
  thumbnailTitle      String?
  thumbnailMeta       String?
  previewImage        String?
  objective           String?
  hashtags            String[]  @default([])
  targetAudience      String?
  startsAt            DateTime?
  endsAt              DateTime?
  timelineLabel       String?
  timelineValue       String?
  creatorsLimit       Int?
  status              String    @default("draft")
  acceptedBudget      Float     @default(0)
  inviteOnlyUntil     DateTime?
  workflow            Json?
  stats               Json?
  payload             Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  invites     MarketingCampaignInvite[]
  acceptances MarketingCampaignAcceptance[]
  proofs      MarketingCampaignProof[]
  zumbarlAd   ZumbarlAd?

  @@index([businessId])
  @@index([status, createdAt])
  @@map("marketing_campaigns")
}

model ZumbarlAd {
  id             String    @id @default(cuid())
  campaignId     String    @unique
  businessId     String?
  headline       String
  description    String
  callToAction   String?
  destinationUrl String?
  status         String    @default("draft") // draft | pending_review | published | withdrawn
  reviewedBy     String?
  reviewedAt     DateTime?
  publishedAt    DateTime?
  payload        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([businessId])
  @@map("zumbarl_ads")
}

model MarketingCampaignInvite {
  id         String   @id @default(cuid())
  campaignId String
  studentId  String
  note       String?
  status     String   @default("sent")
  payload    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([studentId, status])
  @@map("marketing_campaign_invites")
}

model MarketingCampaignAcceptance {
  id                     String   @id @default(cuid())
  campaignId             String
  studentId              String
  status                 String   @default("accepted")
  payoutAmount           Float    @default(0)
  trackingToken          String?  @unique
  trackingDestinationUrl String?
  trackingClicks         Int      @default(0)
  trackingVisits         Int      @default(0)
  promoCode              String?
  payload                Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  campaign    MarketingCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clickEvents MarketingCampaignClick[]

  @@unique([campaignId, studentId])
  @@index([studentId, status])
  @@map("marketing_campaign_acceptances")
}

model MarketingCampaignClick {
  id             String   @id @default(cuid())
  acceptanceId   String
  visitorHash    String
  visits         Int      @default(1)
  firstClickedAt DateTime @default(now())
  lastClickedAt  DateTime @updatedAt

  acceptance MarketingCampaignAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)

  @@unique([acceptanceId, visitorHash])
  @@index([acceptanceId, lastClickedAt])
  @@map("marketing_campaign_clicks")
}

model MarketingCampaignProof {
  id              String   @id @default(cuid())
  campaignId      String
  studentId       String?
  links           String[] @default([])
  screenshots     String[] @default([])
  videos          String[] @default([])
  platformUploads Json?
  reach           Int?
  engagement      Int?
  notes           String?
  status          String   @default("submitted")
  payload         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([studentId])
  @@map("marketing_campaign_proofs")
}

model ConnectProfile {
  id                String   @id @default(cuid())
  studentId         String?  @unique
  interests         String[] @default([])
  safetyPreferences Json?
  visibility        String   @default("campus")
  payload           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("connect_profiles")
}

model ConnectRelationship {
  id              String   @id @default(cuid())
  actorStudentId  String
  targetStudentId String
  type            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actor  StudentProfile @relation("ConnectRelationshipActor", fields: [actorStudentId], references: [id], onDelete: Cascade)
  target StudentProfile @relation("ConnectRelationshipTarget", fields: [targetStudentId], references: [id], onDelete: Cascade)

  @@unique([actorStudentId, targetStudentId, type])
  @@index([actorStudentId, type])
  @@index([targetStudentId, type])
  @@map("connect_relationships")
}

model ConnectStory {
  id               String   @id @default(cuid())
  sourceId         String?  @unique
  studentId        String?
  knowledgeSpaceId String?
  text             String
  mediaUrl         String?
  visibility       String   @default("campus")
  context          String?
  expiresAt        DateTime
  status           String   @default("live")
  payload          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reactions ConnectStoryReaction[]
  comments  ConnectStoryComment[]
  student   StudentProfile?        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([knowledgeSpaceId, status, createdAt])
  @@index([status, expiresAt])
  @@map("connect_stories")
}

model ConnectStoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  studentId String
  reaction  String   @default("like")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story   ConnectStory   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([storyId, studentId])
  @@index([storyId])
  @@index([studentId])
  @@map("connect_story_reactions")
}

model ConnectStoryComment {
  id        String   @id @default(cuid())
  storyId   String
  studentId String
  body      String
  status    String   @default("published")
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story     ConnectStory                  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  student   StudentProfile                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reactions ConnectStoryCommentReaction[]

  @@index([storyId, status, createdAt])
  @@index([studentId])
  @@map("connect_story_comments")
}

model ConnectStoryCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  studentId String
  reaction  String   @default("like")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comment ConnectStoryComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  student StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([commentId, studentId])
  @@index([commentId])
  @@index([studentId])
  @@map("connect_story_comment_reactions")
}

model ConnectPost {
  id               String   @id @default(cuid())
  studentId        String?
  managedProfileId String?
  knowledgeSpaceId String?
  communityGroupId String?
  type             String   @default("post")
  body             String
  tags             Json?
  visibility       String   @default("campus")
  status           String   @default("published")
  reactions        Json?
  saves            Int      @default(0)
  reposts          Int      @default(0)
  payload          Json?

  roadmapSteps      CareerRoadmapStepCompetency[]
  opportunityLinks  OpportunityCompetency[]
  resourceLinks     LearningResourceCompetency[]
  studentStates     StudentCompetencyState[]
  evidence          RoadmapEvidence[]
  evergreenPrograms EvergreenProgramCompetency[]
  placementGoals    PlacementGoal[]
  placementEvidence PlacementEvidence[]

